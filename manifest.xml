<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <!-- ============================================================
       Report This! — Outlook Add-in Manifest
       Post-click incident reporter. Captures the full internet
       headers of a suspicious message, asks the user a few triage
       questions, and opens a pre-filled draft to the support team
       with the original message forwarded as an attachment.
       Runs fully client-side (Office.js). No backend required.
       ============================================================ -->

  <Id>b9571993-8a02-48bf-8270-4899d448aba2</Id>
  <Version>2.0.0.0</Version>
  <ProviderName>Matthijssen</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Report This!"/>
  <Description DefaultValue="Report a suspicious or malicious email to IT. Captures the full message headers, asks what happened, and opens a pre-filled report to your support team with the original message attached."/>

  <IconUrl DefaultValue="https://cornercoderman.github.io/Panic-Button/assets/icon-80.png"/>
  <HighResolutionIconUrl DefaultValue="https://cornercoderman.github.io/Panic-Button/assets/icon-80.png"/>
  <SupportUrl DefaultValue="https://cornercoderman.github.io/Panic-Button/support.html"/>

  <AppDomains>
    <AppDomain>https://cornercoderman.github.io</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <!-- getAllInternetHeadersAsync requires Mailbox requirement set 1.8. -->
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.8"/>
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://cornercoderman.github.io/Panic-Button/taskpane.html"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <!-- ReadItem is sufficient: displayNewMessageForm and
       getAllInternetHeadersAsync both require only read-item. -->
  <Permissions>ReadItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.8">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">

        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>

          <!-- Message Read surface -->
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgReadGroup">
                <Label resid="GroupLabel"/>

                <!-- Ribbon button to open task pane -->
                <Control xsi:type="Button" id="msgReadOpenPaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>

              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>

      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://cornercoderman.github.io/Panic-Button/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://cornercoderman.github.io/Panic-Button/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://cornercoderman.github.io/Panic-Button/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://cornercoderman.github.io/Panic-Button/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://cornercoderman.github.io/Panic-Button/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Report This!"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Report This!"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Report this email to IT. Captures the full headers and sends the original message to your support team."/>
      </bt:LongStrings>
    </Resources>

  </VersionOverrides>
</OfficeApp>
